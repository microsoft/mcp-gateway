{
  "openapi": "3.0.1",
  "info": {
    "title": "MCP Gateway Mangement API",
    "version": "2.0.0",
    "description": "RESTful APIs for MCP Server Management"
  },
    "servers": [
    {
      "url": "http://<resourceLabel>.<location>.cloudapp.azure.com",
      "description": "Azure Deployment"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/adapters": {
      "post": {
        "summary": "Deploy and register a new MCP server",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "imageName": {
                    "type": "string"
                  },
                  "imageVersion": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "imageName",
                  "imageVersion"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Adapter created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Adapter"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List all MCP servers the user can access",
        "responses": {
          "200": {
            "description": "List of adapters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Adapter"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/adapters/{name}": {
      "get": {
        "summary": "Retrieve metadata for a specific adapter",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Adapter metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Adapter"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update the deployment",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Adapter"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Adapter updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Adapter"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove the server",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/adapters/{name}/status": {
      "get": {
        "summary": "Check the deployment status",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Adapter status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "readyReplicas": {
                      "type": "integer"
                    },
                    "updatedReplicas": {
                      "type": "integer"
                    },
                    "availableReplicas": {
                      "type": "integer"
                    },
                    "image": {
                      "type": "string"
                    },
                    "replicaStatus": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/adapters/{name}/logs": {
      "get": {
        "summary": "Access the server's running logs",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Log output",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/tools": {
      "post": {
        "summary": "Register and deploy a new tool with MCP tool definition",
        "description": "Creates a tool deployment that includes tool definition metadata for routing by the tool gateway router",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolData"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tool created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResource"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "get": {
        "summary": "List all registered tools the user can access",
        "responses": {
          "200": {
            "description": "List of tools",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ToolResource"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tools/{name}": {
      "get": {
        "summary": "Retrieve metadata for a specific tool",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tool metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResource"
                }
              }
            }
          },
          "404": {
            "description": "Tool not found"
          }
        }
      },
      "put": {
        "summary": "Update a tool deployment",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResource"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Tool not found"
          }
        }
      },
      "delete": {
        "summary": "Remove a registered tool",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Tool deleted"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/tools/{name}/status": {
      "get": {
        "summary": "Check the deployment status of a tool",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tool deployment status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "readyReplicas": {
                      "type": "integer"
                    },
                    "updatedReplicas": {
                      "type": "integer"
                    },
                    "availableReplicas": {
                      "type": "integer"
                    },
                    "image": {
                      "type": "string"
                    },
                    "replicaStatus": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Tool not found"
          }
        }
      }
    },
    "/tools/{name}/logs": {
      "get": {
        "summary": "Access the tool server's running logs",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "instance",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "The instance index (0-based) of the tool pod to retrieve logs from"
          }
        ],
        "responses": {
          "200": {
            "description": "Log output",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Tool not found"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "Send a stateless MCP request to the tool gateway",
        "description": "Requires MCP 2026-07-28. Every request is independently authorized; no initialize handshake or transport session is supported. Caller-filtered tool catalogs are private. Annotated tool parameters require matching Mcp-Param-* headers. GET and DELETE are not supported.",
        "parameters": [
          { "$ref": "#/components/parameters/McpProtocolVersion" },
          { "$ref": "#/components/parameters/McpMethod" },
          { "$ref": "#/components/parameters/McpName" },
          { "$ref": "#/components/parameters/McpAccept" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/McpRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/McpResponse" },
          "400": { "$ref": "#/components/responses/McpBadRequest" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Access denied or supplied Origin not allowed" },
          "404": { "description": "Unknown MCP method; backend JSON-RPC error is preserved" },
          "405": { "$ref": "#/components/responses/McpMethodNotAllowed" },
          "503": { "description": "No ready tool gateway instances" }
        }
      }
    },
    "/adapters/{name}/mcp": {
      "post": {
        "summary": "Send a stateless MCP request to an adapter",
        "description": "Requires a MCP 2026-07-28 adapter and client. Independently selects a ready adapter pod after authorizing access. Legacy session headers and session_id query values do not affect routing. Backend errors and request-scoped SSE are preserved; subscriptions/listen is forwarded when implemented by the adapter. GET and DELETE are not supported.",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/McpProtocolVersion" },
          { "$ref": "#/components/parameters/McpMethod" },
          { "$ref": "#/components/parameters/McpName" },
          { "$ref": "#/components/parameters/McpAccept" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/McpRequest" },
        "responses": {
          "200": { "$ref": "#/components/responses/McpResponse" },
          "400": { "$ref": "#/components/responses/McpBadRequest" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Adapter access denied or supplied Origin not allowed" },
          "404": { "description": "Adapter or MCP method not found; backend error bodies are preserved" },
          "405": { "$ref": "#/components/responses/McpMethodNotAllowed" },
          "503": { "description": "No ready adapter instances" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "McpProtocolVersion": {
        "name": "MCP-Protocol-Version", "in": "header", "required": true,
        "description": "Must match params._meta protocolVersion. Legacy and unknown revisions are rejected.",
        "schema": { "type": "string", "enum": ["2026-07-28"] }
      },
      "McpMethod": {
        "name": "Mcp-Method", "in": "header", "required": true,
        "description": "Must match the JSON-RPC method.", "schema": { "type": "string" }
      },
      "McpName": {
        "name": "Mcp-Name", "in": "header",
        "description": "Required for tools/call and prompts/get (params.name) and resources/read (params.uri). Use the MCP Base64 sentinel encoding for unsafe header values. Mcp-Param-* headers similarly mirror schema-annotated arguments.",
        "schema": { "type": "string" }
      },
      "McpAccept": {
        "name": "Accept", "in": "header", "required": true,
        "schema": { "type": "string", "example": "application/json, text/event-stream" }
      }
    },
    "requestBodies": {
      "McpRequest": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/McpRequest" } } }
      }
    },
    "responses": {
      "McpResponse": {
        "description": "JSON-RPC response or an incremental SSE response scoped to this request. Modern results include resultType; complete discovery/list/read results carry ttlMs and cacheScope. A subscription stream stays open until cancelled or completed. No transport session ID is returned.",
        "content": {
          "application/json": { "schema": { "type": "object" } },
          "text/event-stream": { "schema": { "type": "string" } }
        }
      },
      "McpBadRequest": {
        "description": "Missing/malformed headers or metadata, HeaderMismatch (-32020), MissingRequiredClientCapability (-32021), or UnsupportedProtocolVersion (-32022). Backend status and error body are preserved; no legacy fallback.",
        "content": { "application/json": { "schema": { "type": "object" } } }
      },
      "McpMethodNotAllowed": {
        "description": "MCP endpoints support POST, not standalone GET streams or session DELETE.",
        "headers": { "Allow": { "schema": { "type": "string", "example": "POST" } } }
      }
    },
    "schemas": {
      "McpRequest": {
        "type": "object",
        "required": ["jsonrpc", "id", "method", "params"],
        "properties": {
          "jsonrpc": { "type": "string", "enum": ["2.0"] },
          "id": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
          "method": { "type": "string", "example": "server/discover" },
          "params": {
            "type": "object", "required": ["_meta"], "additionalProperties": true,
            "properties": {
              "_meta": {
                "type": "object",
                "required": ["io.modelcontextprotocol/protocolVersion", "io.modelcontextprotocol/clientCapabilities"],
                "properties": {
                  "io.modelcontextprotocol/protocolVersion": { "type": "string", "enum": ["2026-07-28"] },
                  "io.modelcontextprotocol/clientCapabilities": { "type": "object" },
                  "io.modelcontextprotocol/clientInfo": { "type": "object", "description": "Optional self-reported implementation metadata, not authenticated identity." }
                }
              }
            }
          }
        }
      },
      "Adapter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "imageName": {
            "type": "string"
          },
          "imageVersion": {
            "type": "string"
          },
          "environmentVariables": {
            "type": "object"
          },
          "replicaCount": {
            "type": "integer"
          },
          "protocol": {
            "type": "string"
          },
          "connectionType": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUpdatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ToolData": {
        "type": "object",
        "required": ["name", "imageName", "imageVersion", "toolDefinition"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique name of the tool, must match the tool name in toolDefinition"
          },
          "imageName": {
            "type": "string",
            "description": "Container image name for the tool server"
          },
          "imageVersion": {
            "type": "string",
            "description": "Container image version/tag"
          },
          "toolDefinition": {
            "$ref": "#/components/schemas/ToolDefinition"
          },
          "environmentVariables": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Environment variables for the tool server"
          },
          "replicaCount": {
            "type": "integer",
            "default": 1,
            "description": "Number of replicas for the tool server"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the tool"
          },
          "useWorkloadIdentity": {
            "type": "boolean",
            "default": false,
            "description": "Whether to use Azure Workload Identity for authentication. Requires the mcp.admin role or a role listed in WorkloadIdentitySettings:RequiredRoles; otherwise the request is rejected with 403."
          }
        }
      },
      "ToolResource": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ToolData"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the tool resource"
              },
              "createdBy": {
                "type": "string",
                "description": "User who created the tool"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the tool was created"
              },
              "lastUpdatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the tool was last updated"
              }
            }
          }
        ]
      },
      "ToolDefinition": {
        "type": "object",
        "required": ["tool"],
        "properties": {
          "tool": {
            "$ref": "#/components/schemas/McpTool"
          },
          "port": {
            "type": "integer",
            "default": 8000,
            "description": "Port for the tool server endpoint"
          }
        }
      },
      "McpTool": {
        "type": "object",
        "required": ["name", "inputSchema"],
        "properties": {
          "name": {
            "type": "string",
            "description": "The unique name of the MCP tool"
          },
          "title": {
            "type": "string",
            "description": "Human-readable title of the tool"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of what the tool does"
          },
          "type": {
            "type": "string",
            "description": "The type of tool execution",
            "enum": ["http", "function"],
            "default": "http"
          },
          "properties": {
            "type": "object",
            "description": "Tool-specific properties like HTTP method and path",
            "properties": {
              "method": {
                "type": "string",
                "description": "HTTP method for the tool execution",
                "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]
              },
              "path": {
                "type": "string",
                "description": "Path for the tool execution endpoint"
              }
            }
          },
          "inputSchema": {
            "type": "object",
            "description": "JSON Schema defining the tool's input parameters",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["object"]
              },
              "properties": {
                "type": "object",
                "additionalProperties": true
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "annotations": {
            "type": "object",
            "description": "Additional metadata annotations for the tool",
            "properties": {
              "readOnly": {
                "type": "boolean",
                "description": "Indicates if the tool is read-only"
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  }
}
