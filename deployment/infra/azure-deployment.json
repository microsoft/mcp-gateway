    "gatewayImage": {
      "type": "string",
      "defaultValue": "ghcr.io/microsoft/mcp-gateway:latest",
      "metadata": {
        "description": "Exact gateway image to deploy; set to the image built from the checkout being validated."
      }
    },
    "toolGatewayImage": {
      "type": "string",
      "defaultValue": "ghcr.io/microsoft/tool-gateway:latest",
      "metadata": {
        "description": "Exact first-party tool gateway image to deploy."
      }
    },
    "gatewaySecret": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Optional first-party identity-forwarding secret; never supplied to adapter pods. The embedded deployment reuses the stored secret, or generates one on first deployment when omitted. An explicit value must match any existing secret."
      }
    }
  },
  "variables": {
    "$fxv#0": "apiVersion: v1\r\nkind: Namespace\r\nmetadata:\r\n  name: \"${KUBERNETES_NAMESPACE}\"\r\n---\r\napiVersion: v1\r\nkind: Secret\r\nmetadata:\r\n  name: gateway-secret\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\ntype: Opaque\r\ndata:\r\n  gatewaySecret: \"${GATEWAY_SECRET_BASE64}\"\r\n---\r\napiVersion: apps/v1\r\nkind: Deployment\r\nmetadata:\r\n  name: mcpgateway\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\nspec:\r\n  replicas: 1\r\n  selector:\r\n    matchLabels:\r\n      app: mcpgateway\r\n  template:\r\n    metadata:\r\n      labels:\r\n        app: mcpgateway\r\n        azure.workload.identity/use: \"true\"\r\n    spec:\r\n      serviceAccountName: mcpgateway-sa\r\n      containers:\r\n        - name: mcpgateway-container\r\n          image: ${GATEWAY_IMAGE}\r\n          ports:\r\n            - containerPort: 8000\r\n          env:\r\n            - name: ASPNETCORE_ENVIRONMENT\r\n              value: \"Production\"\r\n            - name: GatewaySettings__Secret\r\n              valueFrom:\r\n                secretKeyRef:\r\n                  name: gateway-secret\r\n                  key: gatewaySecret\r\n          resources:\r\n            requests:\r\n              memory: \"256Mi\"\r\n              cpu: \"250m\"\r\n            limits:\r\n              memory: \"512Mi\"\r\n              cpu: \"500m\"\r\n          envFrom:\r\n            - configMapRef:\r\n                name: app-config\r\n---\r\napiVersion: v1\r\nkind: Service\r\nmetadata:\r\n  name: mcpgateway-service\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\n  annotations:\r\n    service.beta.kubernetes.io/azure-load-balancer-internal: \"true\"\r\nspec:\r\n  type: LoadBalancer\r\n  loadBalancerIP: 10.0.1.100\r\n  selector:\r\n    app: mcpgateway\r\n  ports:\r\n    - protocol: TCP\r\n      port: 8000\r\n      targetPort: 8000\r\n---\r\napiVersion: v1\r\nkind: ServiceAccount\r\nmetadata:\r\n  name: mcpgateway-sa\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\n  annotations:\r\n    azure.workload.identity/client-id: \"${AZURE_CLIENT_ID}\"\r\n---\r\napiVersion: v1\r\nkind: ServiceAccount\r\nmetadata:\r\n  name: workload-sa\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\n  annotations:\r\n    azure.workload.identity/client-id: \"${WORKLOAD_CLIENT_ID}\"\r\n---\r\napiVersion: rbac.authorization.k8s.io/v1\r\nkind: Role\r\nmetadata:\r\n  name: app-manager\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\nrules:\r\n  - apiGroups: [\"apps\"]\r\n    resources: [\"statefulsets\"]\r\n    verbs: [\"get\", \"list\", \"create\", \"update\", \"delete\", \"patch\", \"watch\"]\r\n  - apiGroups: [\"\"]\r\n    resources: [\"services\", \"pods\"]\r\n    verbs: [\"get\", \"list\", \"create\", \"update\", \"delete\", \"watch\"]\r\n  - apiGroups: [\"\"]\r\n    resources: [\"pods/log\"]\r\n    verbs: [\"get\", \"watch\"]\r\n---\r\napiVersion: rbac.authorization.k8s.io/v1\r\nkind: RoleBinding\r\nmetadata:\r\n  name: app-manager-binding\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\nsubjects:\r\n  - kind: ServiceAccount\r\n    name: mcpgateway-sa\r\n    namespace: \"${KUBERNETES_NAMESPACE}\"\r\nroleRef:\r\n  kind: Role\r\n  name: app-manager\r\n  apiGroup: rbac.authorization.k8s.io\r\n---\r\napiVersion: v1\r\nkind: ConfigMap\r\nmetadata:\r\n  name: app-config\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\ndata:\r\n  Kubernetes__Namespace: \"${KUBERNETES_NAMESPACE}\"\r\n  AzureAd__Instance: \"https://login.microsoftonline.com/\"\r\n  AzureAd__TenantId: \"${TENANT_ID}\"\r\n  AzureAd__ClientId: \"${CLIENT_ID}\"\r\n  AzureAd__Audience: \"${CLIENT_ID}\"\r\n\r\n  CosmosSettings__AccountEndpoint: \"https://mg-storage-${IDENTIFIER}.documents.azure.com:443/\"\r\n  CosmosSettings__DatabaseName: \"McpGatewayDb\"\r\n\r\n  ApplicationInsights__ConnectionString: \"${APPINSIGHTS_CONNECTION_STRING}\"\r\n\r\n  ContainerRegistrySettings__Endpoint: \"mgreg${IDENTIFIER}.azurecr.io\"\r\n\r\n  PublicOrigin: \"${PUBLIC_ORIGIN}\"\r\n---\r\napiVersion: apps/v1\r\nkind: StatefulSet\r\nmetadata:\r\n  name: toolgateway\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\nspec:\r\n  serviceName: toolgateway-service\r\n  replicas: 1\r\n  selector:\r\n    matchLabels:\r\n      app: toolgateway\r\n  template:\r\n    metadata:\r\n      labels:\r\n        app: toolgateway\r\n        azure.workload.identity/use: \"true\"\r\n        adapter/type: \"mcp\"\r\n    spec:\r\n      serviceAccountName: mcpgateway-sa\r\n      containers:\r\n        - name: toolgateway-container\r\n          image: ${TOOL_GATEWAY_IMAGE}\r\n          ports:\r\n            - containerPort: 8000\r\n          env:\r\n            - name: ASPNETCORE_ENVIRONMENT\r\n              value: \"Production\"\r\n            - name: GatewaySettings__Secret\r\n              valueFrom:\r\n                secretKeyRef:\r\n                  name: gateway-secret\r\n                  key: gatewaySecret\r\n          resources:\r\n            requests:\r\n              memory: \"256Mi\"\r\n              cpu: \"250m\"\r\n            limits:\r\n              memory: \"512Mi\"\r\n              cpu: \"500m\"\r\n          envFrom:\r\n            - configMapRef:\r\n                name: app-config\r\n---\r\napiVersion: v1\r\nkind: Service\r\nmetadata:\r\n  name: toolgateway-service\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\nspec:\r\n  clusterIP: \"None\"\r\n  selector:\r\n    app: toolgateway\r\n  ports:\r\n    - protocol: TCP\r\n      port: 8000\r\n      targetPort: 8000\r\n---\r\n# NetworkPolicy: Default deny all ingress in the deployment namespace\r\napiVersion: networking.k8s.io/v1\r\nkind: NetworkPolicy\r\nmetadata:\r\n  name: default-deny-ingress\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\nspec:\r\n  podSelector: {}\r\n  policyTypes:\r\n    - Ingress\r\n---\r\n# NetworkPolicy: Allow unrestricted ingress to mcpgateway on port 8000\r\napiVersion: networking.k8s.io/v1\r\nkind: NetworkPolicy\r\nmetadata:\r\n  name: allow-mcpgateway-ingress\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\nspec:\r\n  podSelector:\r\n    matchLabels:\r\n      app: mcpgateway\r\n  policyTypes:\r\n    - Ingress\r\n  ingress:\r\n    - ports:\r\n        - protocol: TCP\r\n          port: 8000\r\n---\r\n# NetworkPolicy: Only mcpgateway and toolgateway can reach adapter/tool pods\r\napiVersion: networking.k8s.io/v1\r\nkind: NetworkPolicy\r\nmetadata:\r\n  name: adapter-access\r\n  namespace: \"${KUBERNETES_NAMESPACE}\"\r\nspec:\r\n  podSelector:\r\n    matchExpressions:\r\n      - key: adapter/type\r\n        operator: In\r\n        values: [mcp, tool]\r\n  policyTypes:\r\n    - Ingress\r\n  ingress:\r\n    - from:\r\n        - podSelector:\r\n            matchLabels:\r\n              app: mcpgateway\r\n        - podSelector:\r\n            matchLabels:\r\n              app: toolgateway\r\n      ports:\r\n        - protocol: TCP\r\n          port: 8000\r\n",
    "tlsEnabled": "[not(empty(parameters('tlsCertificateData')))]",
    "resourceLabelLower": "[toLower(parameters('resourceLabel'))]",
    "aksNameBase": "[format('mg-aks-{0}', variables('resourceLabelLower'))]",
    "aksName": "[substring(variables('aksNameBase'), 0, min(length(variables('aksNameBase')), 63))]",
    "acrNameBase": "[format('mgreg{0}', variables('resourceLabelLower'))]",
    "acrName": "[substring(variables('acrNameBase'), 0, min(length(variables('acrNameBase')), 50))]",
    "cosmosDbAccountNameBase": "[format('mg-storage-{0}', variables('resourceLabelLower'))]",
