    "userAssignedIdentityNameBase": "[format('mg-identity-{0}', variables('resourceLabelLower'))]",
    "userAssignedIdentityName": "[substring(variables('userAssignedIdentityNameBase'), 0, min(length(variables('userAssignedIdentityNameBase')), 128))]",
    "appInsightsNameBase": "[format('mg-ai-{0}', variables('resourceLabelLower'))]",
