    "federatedCredWorkloadNameBase": "[format('{0}-workload', variables('federatedCredName'))]",
    "federatedCredWorkloadName": "[substring(variables('federatedCredWorkloadNameBase'), 0, min(length(variables('federatedCredWorkloadNameBase')), 128))]"
