      "value": "[parameters('resourceLabel')]"
    },
    "kubernetesNamespace": {
      "type": "string",
      "value": "[parameters('kubernetesNamespace')]"
    },
    "tenantId": {
      "type": "string",
      "value": "[tenant().tenantId]"
    },
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "publicIpFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName')), '2022-05-01').dnsSettings.fqdn]"
    },
    "publicOrigin": {
      "type": "string",
      "value": "[format('{0}://{1}/', if(variables('tlsEnabled'), 'https', 'http'), reference(resourceId('Microsoft.Network/publicIPAddresses', variables('publicIpName')), '2022-05-01').dnsSettings.fqdn)]"
    }
  }
}